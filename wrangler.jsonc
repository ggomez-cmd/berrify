{
  "name": "berrify",
  "main": "workers/index.ts",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "build": {
    "command": "npm run build",
    "watch_dir": ["src", "workers", "public", "index.html"]
  }
}
